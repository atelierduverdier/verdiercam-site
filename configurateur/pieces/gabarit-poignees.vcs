// GABARIT DE POIGNÉES DE MEUBLE — pour percer les deux trous d'une poignée de tiroir ou de porte, d'aplomb, centrés, à
// la même hauteur sur toute une cuisine : la butée contre le chant de la façade, l'encoche du milieu sur le trait d'axe,
// et on perce dans les trous de l'entraxe voulu (96, 128, 160 ou 192 mm, les entraxes du commerce).
// thème : Atelier et gabarits
//
// LA PLAQUE : une rangée de paires de trous (Ø`d_trou`, une vis M4 passe), symétriques autour de l'axe, à `retrait` de la
// face de la BUTÉE (la distance du chant de la façade aux trous) ; l'entraxe gravé sous chaque trou ; l'axe gravé, et une
// ENCOCHE en V au milieu de chaque grand côté pour viser le trait de crayon. LA BUTÉE : une latte sous la plaque, qui y entre
// par deux tenons.
//
// L'USINAGE : l'axe et les entraxes (Gravure), les trous (Perçage, Foret Ø5), les mortaises (Contour intérieur, coins
// dégagés), puis la plaque et la butée (Contour extérieur, onglets). Hêtre ou contreplaqué de bouleau de 12 ; pour un
// usage suivi, des canons de perçage.

retrait    = 35;     // de la face de la butée à l'axe des trous (mm) : la hauteur de la poignée sur la façade
d_trou     = 5;      // Ø des trous (mm) : celui du Foret Ø5
hauteur_butee = 25;  // hauteur de la butée sous la plaque (mm)
jeu        = 0.1;    // jeu des tenons, par côté (mm)
epaisseur  = 12;     // épaisseur (mm)
espace     = 10;     // entre deux pièces (mm)
rognure    = 5;      // du bord du brut aux pièces (mm)

entraxes = [96, 128, 160, 192];
ep = epaisseur;
L = max(entraxes) + 60;  W = 22 + retrait + 25; // la plaque
yf = 22;                                       // la face de la butée, depuis le bord de la plaque (10 de bois devant sa mortaise)
ya = yf + retrait;                             // l'axe des trous
lt = 40;  xt = [20, L - 20 - lt];              // les tenons de la butée
si (d_trou != 5)
    echo("Le Foret Ø5 de la bibliothèque perce les trous : un autre Ø demande un autre foret.");
planche([L + 2 * rognure, W + espace + hauteur_butee + ep + 2 * rognure, epaisseur]);

// ── La plaque : son contour avec les deux encoches en V au milieu des grands côtés ──
o = [rognure, rognure + hauteur_butee + ep + espace];
v = 6;                                         // la demi-ouverture et la profondeur d'une encoche
p = polyligne([o, o + [L / 2 - v, 0], o + [L / 2, v], o + [L / 2 + v, 0], o + [L, 0], o + [L, W], o + [L / 2 + v, W], o + [L / 2, W - v],
               o + [L / 2 - v, W], o + [0, W]], fermee = vrai);
nommer(#p, "plaque");
pour (e = entraxes)
    pour (s = [-1, 1]) {
        t = cercle(o + [L / 2 + s * e / 2, ya], d_trou / 2);
        nommer(#t, "trou");
        lbl = str(e);
        M = mesure_texte(lbl, 10, "Hershey Sans1") / 10;
        g = texte(o + [L / 2 + s * e / 2 - 3.5 * (M[2] + M[3]) / 2, ya - d_trou / 2 - 7], 3.5, lbl, police = "Hershey Sans1");
        nommer(#g, "gravure");
    }
ax = ligne(o + [L / 2, v + 3], o + [L / 2, W - v - 3]);
nommer(#ax, "gravure");
pour (x = xt) {
    m = rect(o + [x - jeu, yf - ep - jeu], [lt + 2 * jeu, ep + 2 * jeu]);
    nommer(#m, "mortaise");
}

// ── La butée : une latte, ses deux tenons en haut ──
ob = [rognure, rognure];
b = polyligne(concat([ob, ob + [L, 0], ob + [L, hauteur_butee]],
                     [for (x = [xt[1], xt[0]]) for (k = [0 : 3]) ob + [x + [lt, lt, 0, 0][k], hauteur_butee + [0, ep, ep, 0][k]]],
                     [ob + [0, hauteur_butee]]), fermee = vrai);
nommer(#b, "butée");

// ── L'USINAGE, déclaré ──
usinage("gravure", "gravure", outil = "Pointe V 90", profondeur = 0.5, nom = "Axe et entraxes");
usinage("percage", "trou", outil = "Foret Ø5", profondeur = epaisseur, nom = "Trous");
usinage("contour", "mortaise", outil = "Fraise droite Ø6", cote = "interieur", onglets = 0, coins = "dogbone",
        profondeur = epaisseur, passe = 3, nom = "Mortaises");
usinage("contour", "butée", outil = "Fraise droite Ø6", cote = "exterieur", coins = "dogbone", profondeur = epaisseur, passe = 3,
        onglets = 2, onglet_long = 6, onglet_haut = 2, nom = "Butée");
usinage("contour", "plaque", outil = "Fraise droite Ø6", cote = "exterieur", profondeur = epaisseur, passe = 3,
        onglets = 2, onglet_long = 6, onglet_haut = 2, nom = "Plaque");
