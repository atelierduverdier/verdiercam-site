// CALENDRIER PERPÉTUEL — le calendrier de bureau qui ne finit jamais : un socle à quatre fentes, et des plaquettes qu'on y
// plante chaque matin — le jour de la semaine, les dizaines (0 à 3), les unités (0 à 9), le mois. Les plaquettes du
// jour se rangent derrière celle qu'on montre.
// thème : Décoration et cadeaux
//
// LES PLAQUETTES : `hauteur` de haut ; celles des chiffres de `largeur_chiffre`, celles des mots (sept jours, douze mois)
// de `largeur_mot`. Le texte est gravé, centré, à la taille qui tient dans la plaquette. LE SOCLE : quatre FENTES de
// l'épaisseur plus le `jeu`, de la largeur de leur plaquette plus le jeu, creusées de `profondeur_fente` ; une plaquette y
// tient debout, les autres de sa sorte s'appuient derrière (la fente est assez longue pour toutes en épaisseur).
//
// L'USINAGE : les textes (Gravure, Pointe V 90°), les fentes (Poche, coins dégagés), puis les plaquettes et le socle
// (Contour extérieur, onglets). Contreplaqué de bouleau de 9, ou un bois dur.

hauteur    = 50;     // hauteur d'une plaquette (mm)
largeur_chiffre = 34; // largeur d'une plaquette de chiffre (mm)
largeur_mot = 80;    // largeur d'une plaquette de mot (mm)
profondeur_fente = 5; // profondeur des fentes du socle (mm)
jeu        = 0.2;    // jeu des plaquettes dans les fentes, par côté (mm)
epaisseur  = 9;      // épaisseur (mm)
espace     = 8;      // entre deux pièces (mm)
rognure    = 5;      // du bord du brut aux pièces (mm)

ep = epaisseur;  H = hauteur;  lc = largeur_chiffre;  lm = largeur_mot;
jours = ["LUNDI", "MARDI", "MERCREDI", "JEUDI", "VENDREDI", "SAMEDI", "DIMANCHE"];
mois = ["JANVIER", "FÉVRIER", "MARS", "AVRIL", "MAI", "JUIN", "JUILLET", "AOÛT", "SEPTEMBRE", "OCTOBRE", "NOVEMBRE", "DÉCEMBRE"];
// Toutes les plaquettes : [texte, largeur]
plaquettes = concat([for (j = jours) [j, lm]], [for (k = [0 : 3]) [str(k), lc]], [for (k = [0 : 9]) [str(k), lc]], [for (m = mois) [m, lm]]);
n = len(plaquettes);
// En colonnes de cinq rangées : les mots dans les deux premières colonnes…
par = 6;  colonnes = ceil(n / par);
function x(k) = floor(k / par) * (lm + espace);
// Le socle : quatre fentes côte à côte (jour, dizaine, unité, mois), chacune assez profonde (en y) pour toute sa sorte.
fentes = [[lm, 7], [lc, 4], [lc, 10], [lm, 12]];
Ls = lm + lc + lc + lm + 5 * 14;
Ds = 12 * (ep + 2 * jeu) + 2 * 18;
si (profondeur_fente > epaisseur - 3)
    echo("Les fentes percent presque le socle : moins profondes.");
planche([max(colonnes * (lm + espace) - espace, Ls) + 2 * rognure, par * (H + espace) - espace + espace + Ds + 2 * rognure, epaisseur]);

// ── Les plaquettes, leur texte centré ──
pour (k = [0 : n - 1]) {
    o = [rognure + x(k), rognure + Ds + espace + (k % par) * (H + espace)];
    w = plaquettes[k][1];
    p = rect(o, [w, H], 3);
    nommer(#p, "plaquette");
    s = plaquettes[k][0];
    M = mesure_texte(s, 10, "Hershey Sans1") / 10;
    h = min(w == lc ? 30 : 11, (w - 10) / (M[3] - M[2]));
    t = texte(o + [w / 2 - h * (M[2] + M[3]) / 2, H / 2 - h / 2], h, s, police = "Hershey Sans1");
    nommer(#t, "texte");
}

// ── Le socle et ses quatre fentes ──
os = [rognure, rognure];
b = rect(os, [Ls, Ds], 6);
nommer(#b, "socle");
pour (k = [0 : 3]) {
    xf = 14 + (k > 0 ? lm + 14 : 0) + (k > 1 ? lc + 14 : 0) + (k > 2 ? lc + 14 : 0);
    f = rect(os + [xf - jeu, 18 - jeu], [fentes[k][0] + 2 * jeu, fentes[k][1] * (ep + 2 * jeu)]);
    nommer(#f, "fente");
}

// ── L'USINAGE, déclaré ──
usinage("gravure", "texte", outil = "Pointe V 90", profondeur = 0.6, nom = "Textes");
usinage("poche", "fente", outil = "Fraise droite Ø3", coins = "dogbone", profondeur = profondeur_fente, passe = 1.5, nom = "Fentes");
usinage("contour", "plaquette", outil = "Fraise droite Ø3", cote = "exterieur", profondeur = epaisseur, passe = 1.5,
        onglets = 2, onglet_long = 3, onglet_haut = 1, nom = "Plaquettes");
usinage("contour", "socle", outil = "Fraise droite Ø3", cote = "exterieur", profondeur = epaisseur, passe = 1.5,
        onglets = 3, onglet_long = 5, onglet_haut = 1, nom = "Socle");
