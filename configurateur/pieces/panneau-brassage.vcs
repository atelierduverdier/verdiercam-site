// PANNEAU DE BRASSAGE POUR JACKS — le « patch » du studio ou de la baie de synthés modulaires, au format rack 19″ : deux
// rangées de prises jack 6,35, numérotées, chaque prise tenue par son écrou dans un bois aminci par derrière.
// thème : Électronique et boîtiers
//
// LES COTES DU RACK (EIA-310) : 482,6 de large, `unites` × 44,45 − 0,8 de haut, deux lumières de 10 × 6,5 par unité et par
// oreille, à 465,1 d'entraxe (comme la façade de rack du catalogue). LES PRISES : `prises` par rangée, deux rangées, au
// `pas` ; un trou de Ø9,5 chacune, un LAMAGE de Ø`d_lamage` par derrière qui ne laisse que `peau` (le canon d'une prise
// est court). Le numéro de chaque paire gravé entre les deux rangées.
//
// L'USINAGE : les lamages (Poche, face du dessous, fraise droite Ø6), les numéros (Gravure, Pointe V 90°), les trous et
// les lumières (Contour intérieur, fraise droite Ø3), puis le panneau (Contour extérieur, onglets). Contreplaqué de bouleau
// de 9, ou noyer.

unites     = 2;      // hauteur en unités de rack (1U = 44,45 mm)
prises     = 16;     // prises par rangée
pas        = 22;     // d'une prise à la suivante (mm)
d_lamage   = 18;     // Ø du lamage sous chaque prise (mm)
peau       = 3;      // le bois laissé sous les écrous (mm)
epaisseur  = 9;      // épaisseur (mm)
rognure    = 5;      // du bord du brut au panneau (mm)

U = max(1, round(unites));  n = max(1, round(prises));
W = 482.6;  H = U * 44.45 - 0.8;
xl = (W - 465.1) / 2;
x0 = (W - (n - 1) * pas) / 2;
yr = [H / 2 - 18, H / 2 + 18];                 // les deux rangées
si (x0 - d_lamage / 2 < 30)
    echo("Les prises débordent sur les oreilles du rack : moins de prises, ou un pas plus petit.");
si (pas < d_lamage + 3)
    echo("Les lamages se touchent presque : un pas plus grand.");
si (U < 2)
    echo("En 1U, les deux rangées et leurs numéros ne tiennent pas : 2U au moins.");
planche([W + 2 * rognure, H + 2 * rognure, epaisseur]);
o = [rognure, rognure];
f = rect(o, [W, H], 2);
nommer(#f, "panneau");
pour (u = [0 : U - 1])
    pour (y = [6.35, 38.1])
        pour (x = [xl, W - xl]) {
            l = oblong(o + [x, u * 44.45 + y - 0.4], 10, 6.5);
            nommer(#l, "lumière");
        }
pour (i = [0 : n - 1]) {
    pour (y = yr) {
        t = cercle(o + [x0 + i * pas, y], 4.75);
        nommer(#t, "prise");
    }
    s = str(i + 1);
    M = mesure_texte(s, 10, "Hershey Sans1") / 10;
    g = texte(o + [x0 + i * pas - 5 * (M[2] + M[3]) / 2, H / 2 - 2.5], 5, s, police = "Hershey Sans1");
    nommer(#g, "numéro");
}
face("dessous");
pour (i = [0 : n - 1])
    pour (y = yr) {
        a = cercle(o + [x0 + i * pas, y], d_lamage / 2);
        nommer(#a, "lamage");
    }
face("dessus");

// ── L'USINAGE, déclaré ──
usinage("poche", "lamage", outil = "Fraise droite Ø6", profondeur = epaisseur - peau, passe = 3, nom = "Lamages");
usinage("gravure", "numéro", outil = "Pointe V 90", profondeur = 0.5, nom = "Numéros");
usinage("contour", "prise", outil = "Fraise droite Ø3", cote = "interieur", onglets = 0, profondeur = epaisseur, passe = 1.5,
        nom = "Trous des prises");
usinage("contour", "lumière", outil = "Fraise droite Ø3", cote = "interieur", onglets = 0, profondeur = epaisseur, passe = 1.5,
        nom = "Lumières");
usinage("contour", "panneau", outil = "Fraise droite Ø6", cote = "exterieur", profondeur = epaisseur, passe = 3,
        onglets = 4, onglet_long = 8, onglet_haut = 2, nom = "Panneau");
