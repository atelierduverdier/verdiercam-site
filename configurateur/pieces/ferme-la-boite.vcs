// FERME LA BOÎTE — le jeu de dés des marins (« shut the box ») : neuf tuiles numérotées de 1 à 9 ; on lance deux dés et on
// retourne des tuiles dont la somme fait celle des dés. Quand plus rien ne va, les tuiles encore ouvertes comptent contre
// soi ; tout fermer, c'est gagner.
// thème : Jeux et jouets
//
// LE PLATEAU : une rangée de neuf LOGEMENTS (la tuile plus le `jeu`, creusés de `profondeur_logement`), leur numéro gravé
// au-dessus, et une PISTE pour les dés (une cuvette de `hauteur_piste`, creusée de `profondeur_piste`). LES TUILES : `tuile_l`
// × `tuile_h`, le numéro gravé sur une face : à plat, chiffre dessus, la tuile est ouverte ; retournée, fermée.
//
// L'USINAGE : les numéros (Gravure, Pointe V 90°), les logements et la piste (Poche, coins dégagés pour les logements), puis
// les tuiles et le plateau (Contour extérieur, onglets). Hêtre de 12 ; deux dés, un feutre au fond de la piste.

tuile_l    = 28;     // largeur d'une tuile (mm)
tuile_h    = 40;     // hauteur d'une tuile (mm)
jeu        = 0.3;    // jeu d'une tuile dans son logement, par côté (mm)
profondeur_logement = 5;  // profondeur des logements (mm)
hauteur_piste = 90;  // hauteur de la piste des dés (mm)
profondeur_piste = 7;  // profondeur de la piste (mm)
epaisseur  = 12;     // épaisseur (mm)
espace     = 10;     // entre deux pièces (mm)
rognure    = 5;      // du bord du brut aux pièces (mm)

tl = tuile_l;  th = tuile_h;  lg = tl + 2 * jeu;
pas = lg + 6;                                  // d'un logement au suivant
m = 14;                                        // la marge du plateau
L = 9 * pas - 6 + 2 * m;
H = m + hauteur_piste + 12 + th + 2 * jeu + 14 + m;   // la piste, puis les logements, puis leurs numéros
si (max(profondeur_piste, profondeur_logement) > epaisseur - 3)
    echo("Une cuvette perce presque le plateau : moins profonde.");
planche([max(L, 9 * (tl + espace) - espace) + 2 * rognure, H + espace + th + 2 * rognure, epaisseur]);

// ── Le plateau ──
o = [rognure, rognure + th + espace];
p = rect(o, [L, H], 8);
nommer(#p, "plateau");
pi = rect(o + [m, m], [L - 2 * m, hauteur_piste], 14);
nommer(#pi, "piste");
yl = m + hauteur_piste + 12;
pour (k = [0 : 8]) {
    x = m + k * pas;
    lo = rect(o + [x, yl], [lg, th + 2 * jeu]);
    nommer(#lo, "logement");
    s = str(k + 1);
    M = mesure_texte(s, 10, "Hershey Sans1") / 10;
    n = texte(o + [x + lg / 2 - 7 * (M[2] + M[3]) / 2, yl + th + 2 * jeu + 4], 7, s, police = "Hershey Sans1");
    nommer(#n, "numéro");
}

// ── Les tuiles, en bas de la planche, leur numéro gravé ──
pour (k = [0 : 8]) {
    ot = [rognure + k * (tl + espace), rognure];
    t = rect(ot, [tl, th], 2);
    nommer(#t, "tuile");
    s = str(k + 1);
    M = mesure_texte(s, 10, "Hershey Sans1") / 10;
    n = texte(ot + [tl / 2 - 20 * (M[2] + M[3]) / 2, th / 2 - 10], 20, s, police = "Hershey Sans1");
    nommer(#n, "numéro");
}

// ── L'USINAGE, déclaré ──
usinage("gravure", "numéro", outil = "Pointe V 90", profondeur = 1, nom = "Numéros");
usinage("poche", "logement", outil = "Fraise droite Ø6", coins = "dogbone", profondeur = profondeur_logement, passe = 2.5, nom = "Logements");
usinage("poche", "piste", outil = "Fraise droite Ø6", profondeur = profondeur_piste, passe = 3.5, nom = "Piste des dés");
usinage("contour", "tuile", outil = "Fraise droite Ø6", cote = "exterieur", profondeur = epaisseur, passe = 3,
        onglets = 2, onglet_long = 4, onglet_haut = 1.5, nom = "Tuiles");
usinage("contour", "plateau", outil = "Fraise droite Ø6", cote = "exterieur", profondeur = epaisseur, passe = 3,
        onglets = 4, onglet_long = 8, onglet_haut = 2, nom = "Plateau");
